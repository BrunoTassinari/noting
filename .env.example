# String de conexão do Postgres (Neon: Dashboard → Connect, use a "pooled").
# Ex.: postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Segredo para assinar sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública do app. Local: http://localhost:3000
# Na Vercel: https://seu-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
